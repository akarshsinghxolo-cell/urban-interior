# ============================================================================
# Urban Castle — Environment Variables
# ============================================================================
# Copy this file to .env (local dev) or set these in Vercel → Settings →
# Environment Variables (production).
#
# The app auto-detects whether Supabase tables exist. If they don't, it falls
# back to in-memory seed data (data resets on restart). Once you apply the
# Supabase schema, all reads/writes go to Supabase automatically.
# ============================================================================

# ── Supabase (REQUIRED for production) ──────────────────────────────────────
# Get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://smfqwexofoqqrrhbzwmx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_1l2zY_kSY_RMuWCx2j-rIg_itdtGt5x"
SUPABASE_SECRET_KEY="sb_secret_lmAtz6j8wjDxwW9XozK-9Q_JaVJ5uon"
SUPABASE_JWKS_URL="https://smfqwexofoqqrrhbzwmx.supabase.co/auth/v1/.well-known/jwks.json"
# Optional: override JWKS URL (defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# ── Session security (REQUIRED — generate a long random string) ─────────────
# Generate with: openssl rand -hex 48
UC_SESSION_SECRET="urban-interior-rdash-session-secret-2026-very-long-random-key"
UC_WORKSPACE_ID="default"

# ── Google Drive OAuth credentials encryption key (optional) ────────────────
# Generate with: openssl rand -hex 32
UC_DRIVE_CREDENTIALS_KEY="generate-a-32-byte-random-string-here"

# ── First owner (super owner — hardcoded fallback, override here) ───────────
# This user can log in even before any Supabase Auth user exists.
UC_OWNER_EMAIL="akarshsingh4@gmail.com"
UC_OWNER_NAME="Akarsh Singh"
UC_OWNER_PASSWORD="Akarsh@123."

# ── Google Drive integration (OPTIONAL — for media storage) ─────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI for production: https://your-app.vercel.app/api/google-drive/oauth/callback
GOOGLE_DRIVE_OAUTH_CLIENT_ID=""
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_FOLDER_NAME="Urban Castle"
