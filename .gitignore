tool-results/
.zscripts/
*.pid
*.log
upload/

# QA screenshots and downloaded images — never commit
download/
screenshots/
*.png
!public/logo.svg

# Extracted upload artifacts
upload/

# Example/demo code
examples/

# Empty placeholder
mini-services/

# Uploaded zip
public/UU.zip
bun.lock

# Playwright e2e artifacts
test-results/
playwright-report/
