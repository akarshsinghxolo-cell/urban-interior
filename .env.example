# Urban Castle environment template
# Copy to .env.local for local development. Never commit real values.

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SECRET_KEY="sb_secret_replace_me"

UC_SESSION_SECRET="replace-with-at-least-32-random-characters"
UC_WORKSPACE_ID="default"

# Optional background synchronization
# Leave unset or set to 0 on Supabase Free / Vercel Hobby deployments.
# Set to 1 only when cross-session delta polling is intentionally enabled.
NEXT_PUBLIC_UC_DELTA_SYNC_ENABLED="0"

# Optional integrations
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
UC_DRIVE_CREDENTIALS_KEY="replace-with-a-random-encryption-key"
GOOGLE_DRIVE_OAUTH_CLIENT_ID=""
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_FOLDER_NAME="Urban Castle"
# Local development only. Never enable this in production; when omitted the
# application fails closed if the Supabase entity schema is unavailable.
UC_ALLOW_IN_MEMORY_WORKSPACE_FALLBACK=0
