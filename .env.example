# Urban Castle environment template
# Copy to .env.local for local development. Never commit real values.

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SECRET_KEY="sb_secret_replace_me"

UC_SESSION_SECRET="replace-with-at-least-32-random-characters"
UC_WORKSPACE_ID="default"

# Optional background synchronization
# Leave unset or set to 0 on Supabase Free / Vercel Hobby deployments.
# Set to 1 only when cross-session delta polling is intentionally enabled.
NEXT_PUBLIC_UC_DELTA_SYNC_ENABLED="0"

# Google Drive integration
# Keep OAuth secrets and the token-encryption key server-side only.
GOOGLE_DRIVE_OAUTH_CLIENT_ID="replace_me.apps.googleusercontent.com"
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET="replace_me"
DRIVE_TOKEN_ENCRYPTION_KEY="replace_with_a_long_random_secret"

# Read in code, safe to leave unset (documented defaults):
# NEXT_PUBLIC_UC_URL_NAVIGATION   set to "0" to disable client-side URL navigation history
# UC_WORKSPACE_DEFAULT_ENTRY      override the default post-signin entry route
# NEXT_PUBLIC_APP_URL             explicit public origin (recommended on Vercel)
# GOOGLE_DRIVE_MAX_UPLOAD_BYTES   max single upload size (server default applies)
# UC_OWNER_EMAIL                  super-owner sign-in email (default akarshsingh4@gmail.com)
# UC_OWNER_PASSWORD               super-owner password; when set it replaces the built-in default entirely
# UC_SUPER_OWNER_STAFF_ID         Staff record anchored to the static super-owner session (default staff-owner)
# NOMINATIM_USER_AGENT            User-Agent for geocoding requests
# CRON_SECRET / CRON_BEARER_TOKEN auth for /api/qa/cron (Vercel cron)
